# Linkora Deployment Environment Variables
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Server Public IP / Domain
EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP

# Coturn Secret for Ephemeral HMAC-SHA1 Token Generation
TURN_SECRET=generate_a_secure_random_hex_string_here

# TURN Server Endpoints (comma-separated)
TURN_URLS=turn:YOUR_SERVER_PUBLIC_IP:3478?transport=udp,turn:YOUR_SERVER_PUBLIC_IP:3478?transport=tcp
